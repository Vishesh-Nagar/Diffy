# ============================================================
#  Diffy — Environment Configuration
# ============================================================
#  Copy this file to  .env  and fill in your values.
#  The .env file is git-ignored and will NOT be committed.
#
#  Priority order (highest → lowest):
#    1. Shell / system environment variables
#    2. Values in .env
#    3. Values in ~/.diffy/config.json
#    4. Built-in defaults (see backend/config.py)
# ============================================================

# ----------  Ollama (local LLM)  ----------
# Base URL of the Ollama API server
DIFFY_OLLAMA_URL=http://localhost:11434

# Model name to use for code generation / chat
DIFFY_MODEL=codellama

# ----------  Cloud LLM Providers  ----------
# If ANY of these keys are set, Diffy will use the cloud provider.
# If multiple are set, priority is: OpenAI > Anthropic > Gemini.
# If none are set, Diffy defaults to local Ollama.

# OpenAI
DIFFY_OPENAI_API_KEY=
DIFFY_OPENAI_MODEL=gpt-4o-mini
# DIFFY_OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
DIFFY_ANTHROPIC_API_KEY=
DIFFY_ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Google Gemini
DIFFY_GEMINI_API_KEY=
DIFFY_GEMINI_MODEL=gemini-2.0-flash

# ----------  GitHub Integration  ----------
# Personal access token (PAT) for GitHub API access
# Required for private repos and to avoid rate limits
# Generate one at: https://github.com/settings/tokens
DIFFY_GITHUB_TOKEN=

# ----------  Webhook Server  ----------
# Port the webhook listener binds to
DIFFY_WEBHOOK_PORT=9417

# Secret used to verify incoming GitHub webhook payloads
# Must match the secret configured in your GitHub repo settings
DIFFY_WEBHOOK_SECRET=

# ----------  RAG / Indexing  ----------
# Directory where the commit-diff vector index is stored
# DIFFY_INDEX_DIR=~/.diffy/index

# Maximum number of recent commits to index per repository
DIFFY_MAX_COMMITS=200

# Number of top-k results returned by similarity search
DIFFY_TOP_K=5
